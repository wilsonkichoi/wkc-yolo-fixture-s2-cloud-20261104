#!/bin/sh
# kv: a key-value store. See docs/dev-agents/SPEC.md.
set -u

KV_FILE=${KV_FILE:-$HOME/.kv}

usage() {
  echo "usage: kv <command> [args]" >&2
  echo "run 'kv help' for the commands" >&2
}

cmd_help() {
  echo "help    show this list"
  echo "get     print the value of a key"
}

cmd_get() {
  [ $# -eq 1 ] || exit 2
  printf '%s\n' "$1" | grep -Eq '^[A-Za-z0-9_.-]{1,64}$' || exit 2
  [ -f "$KV_FILE" ] || exit 1
  K=$1 awk -F '\t' '
    $1 == ENVIRON["K"] { v = substr($0, length($1) + 2); print v; found = 1; exit }
    END { exit !found }
  ' "$KV_FILE"
}

cmd_del() {
  [ $# -eq 1 ] || exit 2
  tab=$(printf '\t')
  [ -f "$KV_FILE" ] && grep -q "^$1$tab" "$KV_FILE" || exit 1
  t=$(mktemp "$KV_FILE.XXXXXX")
  grep -v "^$1$tab" "$KV_FILE" > "$t" || true
  mv "$t" "$KV_FILE"
}

main() {
  [ $# -ge 1 ] || { usage; exit 2; }
  cmd=$1
  shift
  case $cmd in
    help) cmd_help "$@" ;;
    get) cmd_get "$@" ;;
    del) cmd_del "$@" ;;
    *) usage; exit 2 ;;
  esac
}

main "$@"
