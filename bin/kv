#!/bin/sh
# kv: a key-value store. See docs/dev-agents/SPEC.md.
set -u

KV_FILE=${KV_FILE:-$HOME/.kv}

usage() {
  echo "usage: kv <command> [args]" >&2
  echo "run 'kv help' for the commands" >&2
}

cmd_help() {
  echo "help    show this list"
  echo "rename  rename a key"
  echo "version print the version"
}

cmd_version() {
  [ $# -eq 0 ] || { usage; exit 2; }
  cat "$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)/VERSION"
}

cmd_rename() {
  [ $# -eq 2 ] || { usage; exit 2; }
  tab=$(printf '\t')
  [ -f "$KV_FILE" ] && grep -q "^$1$tab" "$KV_FILE" || exit 1
  grep -q "^$2$tab" "$KV_FILE" && exit 3
  tmp="$KV_FILE.tmp.$$"
  sed "s/^$1$tab/$2$tab/" "$KV_FILE" > "$tmp" && mv "$tmp" "$KV_FILE"
}

main() {
  [ $# -ge 1 ] || { usage; exit 2; }
  cmd=$1
  shift
  case $cmd in
    help) cmd_help "$@" ;;
    rename) cmd_rename "$@" ;;
    version) cmd_version "$@" ;;
    *) usage; exit 2 ;;
  esac
}

main "$@"
