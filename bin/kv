#!/bin/sh
# kv: a key-value store. See docs/dev-agents/SPEC.md.
set -u

KV_FILE=${KV_FILE:-$HOME/.kv}

usage() {
  echo "usage: kv <command> [args]" >&2
  echo "run 'kv help' for the commands" >&2
}

cmd_help() {
  echo "help    show this list"
  echo "count   count the keys"
  echo "del     delete a key"
}

cmd_del() {
  [ $# -eq 1 ] || { usage; exit 2; }
  [ -f "$KV_FILE" ] || exit 1
  tab=$(printf '\t')
  grep -q "^$1$tab" "$KV_FILE" || exit 1
  tmp="$KV_FILE.tmp.$$"
  grep -v "^$1$tab" "$KV_FILE" > "$tmp" || true
  mv "$tmp" "$KV_FILE"
}

cmd_count() {
  if [ -f "$KV_FILE" ]; then
    n=0
    while IFS= read -r line; do
      n=$((n + 1))
    done < "$KV_FILE"
    echo "$n"
  else
    n=0
    echo "$n"
  fi
}

main() {
  [ $# -ge 1 ] || { usage; exit 2; }
  cmd=$1
  shift
  case $cmd in
    help) cmd_help "$@" ;;
    count) cmd_count "$@" ;;
    del) cmd_del "$@" ;;
    *) usage; exit 2 ;;
  esac
}

main "$@"
