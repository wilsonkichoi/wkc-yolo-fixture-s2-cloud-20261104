#!/bin/sh
# kv: a key-value store. See docs/dev-agents/SPEC.md.
set -u

KV_FILE=${KV_FILE:-$HOME/.kv}

usage() {
  echo "usage: kv <command> [args]" >&2
  echo "run 'kv help' for the commands" >&2
}

cmd_help() {
  echo "help    show this list"
  echo "get     print the value of a key"
  echo "del     remove a key"
}

cmd_get() {
  [ $# -eq 1 ] || { usage; exit 2; }
  printf '%s\n' "$1" | grep -Eq '^[A-Za-z0-9_.-]{1,64}$' || { usage; exit 2; }
  [ -f "$KV_FILE" ] || exit 1
  # Match the key exactly on the first tab-separated field; the key goes in
  # through the environment so awk never treats it as a pattern or an escape.
  KV_KEY=$1 awk -F '\t' '
    $1 == ENVIRON["KV_KEY"] { print $2; found = 1; exit }
    END { exit !found }
  ' "$KV_FILE"
}

cmd_del() {
  [ $# -eq 1 ] || { usage; exit 2; }
  [ -f "$KV_FILE" ] || exit 1
  tab=$(printf '\t')
  grep -q "^$1$tab" "$KV_FILE" || exit 1
  tmp="$KV_FILE.tmp.$$"
  grep -v "^$1$tab" "$KV_FILE" > "$tmp" || true
  mv "$tmp" "$KV_FILE"
}

main() {
  [ $# -ge 1 ] || { usage; exit 2; }
  cmd=$1
  shift
  case $cmd in
    help) cmd_help "$@" ;;
    get) cmd_get "$@" ;;
    del) cmd_del "$@" ;;
    *) usage; exit 2 ;;
  esac
}

main "$@"
