#!/bin/sh
# kv: a key-value store. See docs/dev-agents/SPEC.md.
set -u

KV_FILE=${KV_FILE:-$HOME/.kv}

usage() {
  echo "usage: kv <command> [args]" >&2
  echo "run 'kv help' for the commands" >&2
}

cmd_help() {
  case ${LANG:-} in
    fr*)
      echo "help    affiche cette liste"
      echo "del     supprime une clé" ;;
    *)
      echo "help    show this list"
      echo "del     delete a key" ;;
  esac
}

cmd_del() {
  [ $# -eq 1 ] || { usage; exit 2; }
  [ -f "$KV_FILE" ] || exit 1
  tab=$(printf '\t')
  grep -q "^$1$tab" "$KV_FILE" || exit 1
  tmp="$KV_FILE.tmp.$$"
  grep -v "^$1$tab" "$KV_FILE" > "$tmp" || true
  mv "$tmp" "$KV_FILE"
}

main() {
  [ $# -ge 1 ] || { usage; exit 2; }
  cmd=$1
  shift
  case $cmd in
    help) cmd_help "$@" ;;
    del) cmd_del "$@" ;;
    *) usage; exit 2 ;;
  esac
}

main "$@"
