#!/bin/sh
# kv: a key-value store. See docs/dev-agents/SPEC.md.
set -u

KV_FILE=${KV_FILE:-$HOME/.kv}

usage() {
  echo "usage: kv <command> [args]" >&2
  echo "run 'kv help' for the commands" >&2
}

cmd_help() {
  echo "help    show this list"
  echo "set     store a value under a key"
  echo "del     remove a key"
}

cmd_set() {
  [ $# -eq 2 ] || { usage; exit 2; }
  case $1 in
    *[!A-Za-z0-9_.-]*|'') echo "kv: bad key" >&2; exit 2 ;;
  esac
  [ ${#1} -le 64 ] || { echo "kv: bad key" >&2; exit 2; }
  tab=$(printf '\t')
  case $2 in
    *"$tab"*) echo "kv: bad value" >&2; exit 2 ;;
  esac
  nl='
'
  case $2 in
    *"$nl"*) echo "kv: bad value" >&2; exit 2 ;;
  esac
  tmp="$KV_FILE.tmp.$$"
  if [ -f "$KV_FILE" ]; then
    awk -F "$tab" -v k="$1" '$1 != k' "$KV_FILE" > "$tmp" || { rm -f "$tmp"; exit 1; }
  else
    : > "$tmp"
  fi
  printf '%s\t%s\n' "$1" "$2" >> "$tmp"
  mv "$tmp" "$KV_FILE"
}

cmd_del() {
  [ $# -eq 1 ] || { usage; exit 2; }
  [ -f "$KV_FILE" ] || exit 1
  tab=$(printf '\t')
  grep -q "^$1$tab" "$KV_FILE" || exit 1
  tmp="$KV_FILE.tmp.$$"
  grep -v "^$1$tab" "$KV_FILE" > "$tmp" || true
  mv "$tmp" "$KV_FILE"
}

main() {
  [ $# -ge 1 ] || { usage; exit 2; }
  cmd=$1
  shift
  case $cmd in
    help) cmd_help "$@" ;;
    set) cmd_set "$@" ;;
    del) cmd_del "$@" ;;
    *) usage; exit 2 ;;
  esac
}

main "$@"
