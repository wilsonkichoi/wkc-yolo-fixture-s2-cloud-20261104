#!/bin/sh
# kv: a key-value store. See docs/dev-agents/SPEC.md.
set -u

KV_FILE=${KV_FILE:-$HOME/.kv}

usage() {
  echo "usage: kv <command> [args]" >&2
  echo "run 'kv help' for the commands" >&2
}

cmd_help() {
  echo "help    show this list"
  echo "get     print the value of a key"
}

cmd_get() {
  [ $# -eq 1 ] || { usage; exit 2; }
  [ -f "$KV_FILE" ] || exit 1
  tab=$(printf '\t')
  found=1
  while IFS= read -r line || [ -n "$line" ]; do
    case $line in
      "$1$tab"*) printf '%s\n' "${line#*"$tab"}"; found=0; break ;;
    esac
  done < "$KV_FILE"
  exit $found
}

cmd_count() {
  [ -f "$KV_FILE" ] || { echo 0; return 0; }
  wc -l < "$KV_FILE" | tr -d ' '
}

main() {
  [ $# -ge 1 ] || { usage; exit 2; }
  cmd=$1
  shift
  case $cmd in
    help) cmd_help "$@" ;;
    get) cmd_get "$@" ;;
    count) cmd_count "$@" ;;
    *) usage; exit 2 ;;
  esac
}

main "$@"
