#!/bin/sh
# kv: a key-value store. See docs/dev-agents/SPEC.md.
set -u

KV_FILE=${KV_FILE:-$HOME/.kv}

usage() {
  echo "usage: kv <command> [args]" >&2
  echo "run 'kv help' for the commands" >&2
}

cmd_help() {
  echo "help    show this list"
}

cmd_del() {
  [ $# -eq 1 ] || { usage; exit 2; }
  tab=$(printf '\t')
  [ -f "$KV_FILE" ] && grep -q "^$1$tab" "$KV_FILE" || exit 1
  t=$(mktemp "$KV_FILE.XXXXXX")
  grep -v "^$1$tab" "$KV_FILE" > "$t" || true
  mv "$t" "$KV_FILE"
}

main() {
  [ $# -ge 1 ] || { usage; exit 2; }
  cmd=$1
  shift
  case $cmd in
    help) cmd_help "$@" ;;
    del) cmd_del "$@" ;;
    *) usage; exit 2 ;;
  esac
}

main "$@"
