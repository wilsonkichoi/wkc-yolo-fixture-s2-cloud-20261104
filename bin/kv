#!/bin/sh
# kv: a key-value store. See docs/dev-agents/SPEC.md.
set -u

KV_FILE=${KV_FILE:-$HOME/.kv}

usage() {
  echo "usage: kv <command> [args]" >&2
  echo "run 'kv help' for the commands" >&2
}

cmd_help() {
  echo "help    show this list"
  echo "del     delete a key"
  echo "import  read key=value lines from a file"
}

cmd_del() {
  [ $# -eq 1 ] || { usage; exit 2; }
  [ -f "$KV_FILE" ] || exit 1
  tab=$(printf '\t')
  grep -q "^$1$tab" "$KV_FILE" || exit 1
  tmp="$KV_FILE.tmp.$$"
  grep -v "^$1$tab" "$KV_FILE" > "$tmp" || true
  mv "$tmp" "$KV_FILE"
}

cmd_import() {
  [ $# -eq 1 ] || { usage; exit 2; }
  [ -f "$1" ] || exit 2
  tab=$(printf '\t')
  while IFS= read -r line || [ -n "$line" ]; do
    case $line in *=*) ;; *) exit 2 ;; esac
    k=${line%%=*}
    printf '%s\n' "$k" | grep -Eq '^[A-Za-z0-9_.-]{1,64}$' || exit 2
  done < "$1"
  tmp="$KV_FILE.tmp.$$"
  { [ -f "$KV_FILE" ] && cat "$KV_FILE"; sed "s/=/$tab/" "$1"; } |
    awk -F '\t' '{ v[$1] = $0; if (!($1 in seen)) { seen[$1] = 1; order[++n] = $1 } } END { for (i = 1; i <= n; i++) print v[order[i]] }' > "$tmp" &&
    mv "$tmp" "$KV_FILE"
}

main() {
  [ $# -ge 1 ] || { usage; exit 2; }
  cmd=$1
  shift
  case $cmd in
    help) cmd_help "$@" ;;
    import) cmd_import "$@" ;;
    del) cmd_del "$@" ;;
    *) usage; exit 2 ;;
  esac
}

main "$@"
