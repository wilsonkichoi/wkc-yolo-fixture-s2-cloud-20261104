#!/bin/sh
# kv: a key-value store. See docs/dev-agents/SPEC.md.
set -u

KV_FILE=${KV_FILE:-$HOME/.kv}

usage() {
  echo "usage: kv <command> [args]" >&2
  echo "run 'kv help' for the commands" >&2
}

cmd_help() {
  echo "help    show this list"
}

cmd_get() {
  [ $# -eq 1 ] || exit 2
  tab=$(printf '\t')
  [ -f "$KV_FILE" ] || exit 1
  while IFS=$tab read -r k v; do
    if [ "$k" = "$1" ]; then
      printf '%s\n' "$v"
      exit 0
    fi
  done < "$KV_FILE"
  exit 1
}

main() {
  [ $# -ge 1 ] || { usage; exit 2; }
  cmd=$1
  shift
  case $cmd in
    help) cmd_help "$@" ;;
    get) cmd_get "$@" ;;
    *) usage; exit 2 ;;
  esac
}

main "$@"
